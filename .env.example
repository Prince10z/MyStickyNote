# Google Analytics 4 API Credentials for the Desktop Client (via Measurement Protocol)
GA_MEASUREMENT_ID=G-MYSN123456
GA_API_SECRET=your_api_secret_here

# Optional: Point the desktop app to a remote hosted URL for instant updates (leave blank to load local frontend files)
# APP_REMOTE_URL=https://your-smart-sticky-note-site.com/app

# Local test gateway for the recording pipeline.
# Run `npm run mock:gateway` in another terminal before starting the app.
TRANSCRIPTION_GATEWAY_URL=ws://localhost:8787/v1/live-transcription
TRANSCRIPTION_GATEWAY_TOKEN=dev-token

# Optional cloud sync + accounts (Settings -> Account & Cloud Sync).
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the project's SQL editor
# 3. Copy the Project URL and anon/public key from Project Settings -> API
# Without these, the app works fully offline and sign-in just shows a
# friendly "not configured" message.
SUPABASE_URL=
SUPABASE_ANON_KEY=

<file path=".github/workflows/deploy.yml">
name: Deploy Landing Page to Ubuntu Server
on:
  push:
    branches:
      - main
  workflow_dispatch:
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Install sshpass
        run: |
          sudo apt-get update
          sudo apt-get install -y sshpass
      - name: Deploy to Server
        run: |
          sshpass -p "${{ secrets.SSH_PASSWORD }}" ssh \
            -o StrictHostKeyChecking=no \
            -p ${{ secrets.SSH_PORT }} \
            ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }} "
              set -e
              cd /var/www/mystickynote/MyStickyNote
              echo 'Pulling latest code...'
              git pull origin main
              echo 'Installing dependencies...'
              npm install
              if [ -d landing-page/app ] || [ -d landing-page/pages ]; then
                echo 'Building landing page...'
                cd landing-page
                npm install
                npm run build
                pm2 restart mystickynote-landing || \
                pm2 start npm --name mystickynote-landing -- start
                pm2 save
              else
                echo 'No Next.js app found. Skipping landing page build.'
              fi
            "

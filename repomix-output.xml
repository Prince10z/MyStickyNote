<body class="theme-yellow">
  <div class="glass-container">
    <header class="drag-header">
      <div class="header-left no-drag">
        <button id="btn-new" title="New Sticky Note" class="icon-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
        <button id="btn-color" title="Change Color" class="icon-btn theme-indicator-btn">
          <span class="theme-circle-indicator"></span>
        </button>
        <div id="color-palette" class="color-palette hidden">
          <div class="color-dot yellow active" data-color="yellow" title="Yellow"></div>
          <div class="color-dot blue" data-color="blue" title="Blue"></div>
          <div class="color-dot green" data-color="green" title="Green"></div>
          <div class="color-dot pink" data-color="pink" title="Pink"></div>
          <div class="color-dot purple" data-color="purple" title="Purple"></div>
          <div class="color-dot dark" data-color="dark" title="Dark Slate"></div>
        </div>
      </div>
      <div class="header-center">
        <span class="app-title">Sticky</span>
      </div>

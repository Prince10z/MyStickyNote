{
  "name": "mystickynote",
  "version": "1.0.0",
  "description": "A smart sticky note application for desktop with always-on-top mode, timers, alarms, and stopwatch.",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^31.0.0",
    "playwright": "^1.61.0"
  },
  "build": {
    "appId": "com.prince10z.mystickynote",
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "prince10z",
        "repo": "MyStickyNote"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
